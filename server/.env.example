# 服务端环境配置（复制为 .env 使用）

# LLM：OpenAI 兼容接口，任意兼容服务均可（DeepSeek/通义/vLLM 等）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Embedding：留空则使用 Jieba + BM25 关键词检索，不下载默认模型
# 如需 OpenAI 兼容 embedding 服务，填写以下三项
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=
EMBED_DIMENSIONS=0

# 扫描 PDF / PPTX 图片识别，使用上方 LLM 接口；必须是支持图像输入的模型
LLM_VISION_MODEL=
DOCUMENT_MAX_BYTES=52428800
DOCUMENT_MAX_PAGES=100

# 个人邮箱注册验证码；学校账号注册无需邮件，身份默认待核验
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_SSL=false
SMTP_STARTTLS=true
AUTH_SESSION_HOURS=168
MEETING_IDLE_SECONDS=3
MEETING_MINUTES_LIMIT=24000

# RAG 最大向量距离：越小越严格；超过阈值视为知识库未命中
RAG_MAX_DISTANCE=1.0

# ASR：huawei_sis_realtime（课堂连续识别）| local | mock | openai | huawei_sis（旧一句话接口）
ASR_PROVIDER=huawei_sis_realtime
ASR_LOCAL_MODEL=small
ASR_LOCAL_THREADS=4
DOCUMENT_OCR_PROVIDER=local
DOCUMENT_JOB_WORKERS=2
DOCUMENT_QUEUE_LIMIT=20
DOCUMENT_JOB_RETENTION_DAYS=7
MEETING_WORKERS=4
RAG_CLEANUP_SECONDS=3600
# Multiple API processes with vector search must share a Chroma HTTP server.
CHROMA_HOST=
CHROMA_PORT=8002
CHROMA_SSL=false
ASR_BASE_URL=https://api.openai.com/v1
ASR_API_KEY=
ASR_MODEL=whisper-1
ASR_LANGUAGE=zh
ASR_PROMPT=
# 实时：16kHz / 单声道 / S16LE PCM；音频帧约 200ms，缓存窗口最多 60 秒
ASR_SAMPLE_RATE=16000
ASR_CHANNELS=1
ASR_SAMPLE_WIDTH=2
ASR_CHUNK_MS=4000
ASR_TIMEOUT_SECONDS=60

# 华为云 SIS：填写有效 AK/SK，并在对应区域开通实时语音识别
# PROJECT_ID 是 SIS 所在区域的项目 ID，不是账号 ID
SIS_AK=
SIS_SK=
SIS_PROJECT_ID=
SIS_REGION=cn-north-4
# 实时识别模型，须在所选区域支持；与旧短语音模型分开配置
SIS_REALTIME_PROPERTY=chinese_16k_general
# 默认 wss://sis-ext.<区域>.myhuaweicloud.com；仅填主机，不带路径
SIS_REALTIME_ENDPOINT=
# 官方 SDK 未内置的新区域可手动填写服务地址；常规区域留空
SIS_ENDPOINT=
# 16 kHz 中文课堂录音；需与区域支持的模型保持一致
SIS_PROPERTY=chinese_16k_general
SIS_AUDIO_FORMAT=pcm16k16bit
SIS_ADD_PUNC=yes
SIS_DIGIT_NORM=yes
# 可选：控制台创建的热词表 ID
SIS_VOCABULARY_ID=

# 数据库（默认 SQLite，可换 postgresql+psycopg://...）
DATABASE_URL=sqlite:///./smartstudy.db

# 存储目录
DATA_DIR=./data
