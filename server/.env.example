# 服务端环境配置（复制为 .env 使用）

# LLM：OpenAI 兼容接口，任意兼容服务均可（DeepSeek/通义/vLLM 等）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Embedding：留空则使用 Chroma 默认本地 embedding（Demo 可用）
# 如需 OpenAI 兼容 embedding 服务，填写以下三项
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=

# RAG 最大向量距离：越小越严格；超过阈值视为知识库未命中
RAG_MAX_DISTANCE=1.0

# ASR 适配层：mock | openai（兼容 /audio/transcriptions）| huawei_sis
ASR_PROVIDER=mock
ASR_BASE_URL=https://api.openai.com/v1
ASR_API_KEY=
ASR_MODEL=whisper-1
ASR_LANGUAGE=zh
ASR_PROMPT=
# 客户端当前固定上传：16kHz / 单声道 / S16LE PCM / 每片约 4 秒
ASR_SAMPLE_RATE=16000
ASR_CHANNELS=1
ASR_SAMPLE_WIDTH=2
ASR_CHUNK_MS=4000
ASR_TIMEOUT_SECONDS=60

# 华为云 SIS（ASR_PROVIDER=huawei_sis 时使用）
# PROJECT_ID 是 SIS 所在区域的项目 ID，不是账号 ID
SIS_AK=
SIS_SK=
SIS_PROJECT_ID=
SIS_REGION=cn-north-4
# 官方 SDK 未内置的新区域可手动填写服务地址；常规区域留空
SIS_ENDPOINT=
# 16 kHz 中文课堂录音；需与区域支持的模型保持一致
SIS_PROPERTY=chinese_16k_general
SIS_AUDIO_FORMAT=pcm16k16bit
SIS_ADD_PUNC=yes
SIS_DIGIT_NORM=yes
# 可选：控制台创建的热词表 ID
SIS_VOCABULARY_ID=

# 数据库（默认 SQLite，可换 postgresql+psycopg://...）
DATABASE_URL=sqlite:///./smartstudy.db

# 存储目录
DATA_DIR=./data
